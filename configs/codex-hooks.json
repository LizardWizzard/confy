{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -f ~/.codex/herdr-agent-state.sh ] && bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "~/.codex/hooks/session-memlimit.sh codex",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/hooks/desktop-notify.sh Stop",
            "type": "command"
          }
        ]
      }
    ]
  }
}
